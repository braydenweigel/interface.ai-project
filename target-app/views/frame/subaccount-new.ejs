<!DOCTYPE html>
<html>
<head>
<title>New Sub-Account</title>
<link rel="stylesheet" href="/public/style.css">
</head>
<body>

<h3>New Sub-Account for <%= member.firstName %> <%= member.lastName %> (<%= member.id %>)</h3>

<% if (typeof error !== 'undefined' && error) { %>
<p class="error-text"><%= error %></p>
<% } %>

<form method="POST" action="/app/member/<%= member.id %>/subaccounts/review">
<% if (fail) { %><input type="hidden" name="fail" value="<%= fail %>"><% } %>
<table cellpadding="4">
<tr>
<td>Account Type:</td>
<td>
<select name="type">
<option value="Savings" <%= values.type === 'Savings' ? 'selected' : '' %>>Savings</option>
<option value="Checking" <%= values.type === 'Checking' ? 'selected' : '' %>>Checking</option>
<option value="CD" <%= values.type === 'CD' ? 'selected' : '' %>>CD</option>
</select>
</td>
</tr>
<tr>
<td>Initial Deposit:</td>
<td><input type="number" step="0.01" name="deposit" value="<%= values.deposit %>"></td>
</tr>
<tr>
<td>Confirm:</td>
<td><input type="checkbox" name="confirmed"> I confirm I want to open this sub-account</td>
</tr>
<tr>
<td colspan="2" align="right"><input type="submit" value="Review"></td>
</tr>
</table>
</form>

<p><a href="/app/member/<%= member.id %>/subaccounts">Back to Sub-Accounts</a></p>

</body>
</html>
